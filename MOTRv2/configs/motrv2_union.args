--meta_arch motr
--dataset_file e2e_dance
--epoch 5
--with_box_refine
--lr_drop 4
--lr 2e-4
--lr_backbone 2e-5
--pretrained ${CHECKPOINT_ROOT}/motrv2/r50_deformable_detr_plus_iterative_bbox_refinement-checkpoint.pth
--batch_size 1
--sample_mode random_interval
--sample_interval 10
--sampler_lengths 5
--merger_dropout 0
--dropout 0
--random_drop 0.1
--fp_ratio 0.3
--query_interaction_layer QIMv2
--query_denoise 0.05
--num_queries 10
--det_db det_db_train_gt.json
--mot_path ${DATA_ROOT}/data/motrv2
--mot_train_name train
--use_checkpoint
