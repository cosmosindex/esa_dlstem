tools/plot_satmtb_size_trend.py
tools/plot_exp1_detection_vs_size.py
tools/dota_zeroshot_sdmcar.py
tools/dota_zeroshot_sdmcar_tiled.py
evaluation/_hieum_union_val_curve.py
evaluation/compute_exp1_detection_recall.py

# ------------------------------------------------ vendored third-party repos ----
# Each carries its own .git and is cloned, not committed: the runner that drives
# it names the upstream URL, the pinned commit and every local modification in
# its own docstring.
#
# MOTRv2/ and MOTIP/ are the exception and ARE committed. They are the only two
# methods in the paper with no runner of their own under evaluation/ -- their
# entry points live inside the vendored tree -- and MOTRv2 is the best row in
# the main MOT table, so leaving them out meant the two results a reader is most
# likely to ask about had no code behind them. Their upstream history is parked
# at <repo>/.git-upstream so `git -C MOTRv2 --git-dir=.git-upstream diff` still
# shows what we changed; weights, datasets and outputs stay out (below).
BoT-SORT/
ByteTrack/
FairMOT/
GroundingDINO/
LoRAT/
OC_SORT/
ODTrack/
OOTB/
OSTrack/
RAFT/
SmallTrack/
TGraM/
TrackTrack/
masa/
sam3/
samurai/
siamban/
siamfc-pytorch/
pysot/
Moving-object-detection-DSFNet/

# MOTRv2/ and MOTIP/ are tracked; what must never follow them in:
*/.git-upstream/
MOTIP/pretrains/
MOTIP/datasets/
MOTIP/outputs/
# Upstream's demo notebook: unused here, and its comments are not in English,
# which a double-blind repository has no reason to carry.
MOTIP/demo/
MOTRv2/exps/
MOTRv2/outputs/
Moving-object-detection-in-satellite-videos-HiEUM/

